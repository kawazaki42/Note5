шаблон класса ```cpp std::iterator```

```cpp
template <class T>
class iterator
{
protected:
    int iteration_complete;
public:
    iterator(void);
    virtual void next(void) = 0;
    virtual void reset(void) = 0;
    virtual T &data(void) = 0;
    virtual int end_of_list(void) const;
};
```

